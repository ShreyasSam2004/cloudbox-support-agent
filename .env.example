# CloudBox Support Agent — environment configuration.
# Copy to .env for local development. Never commit .env. In Azure, these values are set on the
# Container App by Terraform, and the API keys are Key Vault references resolved with managed identity.

# ---------------------------------------------------------------- service
ENVIRONMENT=local                     # local | test | dev | staging | prod
LOG_LEVEL=INFO
LOG_JSON=false                        # true in containers (structured logs → Log Analytics)

# ---------------------------------------------------------------- models
# Claude (Anthropic API) runs the agent and the retrieval evaluator; OpenAI provides embeddings.
# In Azure these keys come from Key Vault; locally put them below. Ollama = fully offline alternative.
LLM_PROVIDER=anthropic                # anthropic | openai | ollama (local only)
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium                   # Claude only
EVALUATOR_PROVIDER=                   # defaults to LLM_PROVIDER
EVALUATOR_MODEL=claude-haiku-5-5      # retrieval grader + re-ranker (measured: ~20x cheaper than Sonnet,
                                      # same re-ranking quality); empty = AGENT_MODEL
EVALUATOR_EFFORT=low
AGENT_MAX_OUTPUT_TOKENS=16000         # Claude thinks adaptively and thinking shares this budget (~1024 for small local models)
ANTHROPIC_API_KEY=                    # never commit
OPENAI_API_KEY=                       # never commit

# Offline alternative
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------- embeddings
EMBEDDING_PROVIDER=openai             # ollama (nomic-embed-text, EMBEDDING_DIM=768) for offline work
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------------------------------------------------------------- storage
VECTOR_STORE=memory                   # pgvector in deployed environments
SESSION_STORE=memory                  # postgres
CUSTOMER_STORE=json                   # postgres
TRACE_STORE=memory                    # postgres
DATABASE_URL=                         # postgresql://user:pass@localhost:5432/cloudbox
MEMORY_INDEX_PATH=.data/kb_index.json

# ---------------------------------------------------------------- retrieval & agent
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=4                     # passages returned per search (after re-ranking)
RETRIEVAL_RERANK_POOL=20              # candidates the evaluator re-ranks per search (0 = off)
RETRIEVAL_LEXICAL_WEIGHT=1.0          # keyword (BM25) weight in hybrid fusion
CHUNK_MAX_CHARS=1600                  # chunker size limit (re-ingest after changing)
RETRIEVAL_EVALUATOR_ENABLED=true      # false also disables re-ranking
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
AGENT_TIMEOUT_S=180
TOOL_TIMEOUT_S=30
CONTEXT_MAX_TURNS=6
AGENT_CURRENT_DATE=                   # pin "today" for reproducible evaluation (e.g. 2026-10-09)

# ---------------------------------------------------------------- web search
WEB_SEARCH_PROVIDER=fixture           # tavily | fixture (tests/benchmark) | disabled
TAVILY_API_KEY=

# ---------------------------------------------------------------- security
AUTH_MODE=none                        # jwt in prod (refused otherwise)
JWT_JWKS_URL=                         # e.g. Entra ID: https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CUSTOMER_CLAIM=customer_id
ALLOW_UNVERIFIED_CUSTOMER_LOOKUP=true # false in prod (refused otherwise)
RATE_LIMIT_PER_MINUTE=30
TRUST_FORWARDED_FOR=false             # true behind Azure Front Door / Container Apps ingress
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
ADMIN_API_KEY=                        # enables GET /api/v1/admin/traces/{execution_id}

# ---------------------------------------------------------------- observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
EXPOSE_TRACE_IN_RESPONSE=true
